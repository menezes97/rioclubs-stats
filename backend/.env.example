# Copie este arquivo para .env e preencha com valores reais. Nunca versionar o .env.

DATABASE_URL="postgresql://rioclubs:rioclubs@localhost:5433/rioclubs?schema=public"
DB_USER=rioclubs
DB_PASSWORD=rioclubs
DB_NAME=rioclubs

# RapidAPI / API-Football
API_FOOTBALL_KEY=""
API_FOOTBALL_HOST="free-api-live-football-data.p.rapidapi.com"
API_FOOTBALL_LEAGUE_ID="268"
API_FOOTBALL_SEASON="2026"

# Orçamento de requisições (proteção própria, independente do provedor)
API_FOOTBALL_DAILY_LIMIT="90"

# Job agendado de ingestão (cron expression) — 1x por semana (cada run = 4 requisições, 1 por clube acompanhado)
INGESTION_CRON="0 3 * * 0"

JWT_SECRET=""
PORT="3000"
